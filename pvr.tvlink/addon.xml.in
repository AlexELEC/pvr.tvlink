<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="pvr.tvlink"
  version="22.0.3"
  name="PVR TVLINK Client"
  provider-name="Alex@ELEC">
  <requires>@ADDON_DEPENDS@
  </requires>
  <extension
    point="kodi.pvrclient"
    library_@PLATFORM@="@LIBRARY_FILENAME@"/>
  <extension point="xbmc.addon.metadata">
    <platform>@PLATFORM@</platform>
    <license>GPL-2.0-or-later</license>
    <source>https://github.com/AlexELEC/pvr.tvlink</source>
	<forum>https://github.com/AlexELEC/TVLINK-Releases/discussions</forum>
    <summary lang="en_GB">PVR addon for TVLINK server. http://alexelec.github.io/</summary>
    <description lang="en_GB">TVLINK PVR Client support streaming of Live TV, Timeshift, TV programs archives and EPG.</description>
    <disclaimer lang="en_GB">The authors are in no way responsible for failed playings, incorrect EPG times, wasted hours, or any other undesirable effects.</disclaimer>
    <assets>
      <icon>icon.png</icon>
    </assets>
    <news>
v22.0.3
- Set: one option Use Inputstream FFmpeg Direct
v22.0.2
- Add: always play EPG Tags as live-stream
v22.0.1
- Fix: Timeshift/Catchup
v22.0.0
- Init: first version for Kodi-22 (Piers)
    </news>
  </extension>
</addon>
